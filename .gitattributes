* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.docx binary
*.pt binary
*.mp4 binary

# The start scripts keep the line endings that their shells expect.
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf

# Evaluation records are kept byte for byte; their SHA-256 values are documented.
eval/results/** -text
eval/finetune/** -text
tests/schemas/*.xsd -text
